---
{{ ansible_managed | comment }}

name: contacts_workers
services:
  worker:
    container_name: contacts-worker
    image: "{{ st_contacts_backend_image }}:{{ st_contacts_tag }}"
    env_file: ./env
{% if st_contacts_workers_secret_files | length > 0 %}
    environment:
{% for secret in st_contacts_workers_secret_files %}
      {{ secret.env }}_FILE: /run/secrets/{{ secret.env }}
{% endfor %}
    volumes:
      - ./secrets:/run/secrets:ro
{% endif %}
    # Dramatiq worker. worker.py has no health probe command. The image healthcheck probes the web
    # server, which does not run here.
    command: ["python", "worker.py"]
    healthcheck:
      disable: true
